<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Shaders.Views.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:compute="clr-namespace:ComputeSharp;assembly=ComputeSharp"
             xmlns:controls="clr-namespace:Shaders.Controls"
             xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Shaders.ViewModels"
             Title="Shaders"
             x:DataType="viewModels:MainPageViewModel"
             Padding="24"
             mc:Ignorable="d">
  <Grid RowDefinitions="Auto, Auto, *" RowSpacing="16">
    <Picker Grid.Row="0"
            HorizontalOptions="Center"
            ItemDisplayBinding="{Binding Name, x:DataType=compute:GraphicsDevice}"
            ItemsSource="{Binding GraphicsDevices}"
            SelectedItem="{Binding SelectedGraphicsDevice}" />
    <Slider Grid.Row="1"
            Maximum="10"
            Minimum="0"
            Value="{Binding NeighborDistance}" />
    <controls:ComputeShaderView x:Name="shaderView"
                                Grid.Row="2"
                                GraphicsDevice="{Binding SelectedGraphicsDevice}"
                                HorizontalOptions="Fill"
                                ShaderRunner="{Binding ShaderRunner}"
                                VerticalOptions="Fill" />
  </Grid>

</ContentPage>
